/* ===== Base ===== */
body {
  margin: 0;
  font-family: 'Poppins', sans-serif;
  background-color: #f9fafb;
  color: #222;
}

/* ===== Header ===== */
.services-header {
  text-align: center;
  padding: 3rem 1rem 2rem;
}

.services-header h1 {
  font-size: 2.5rem;
  color: #0077cc;
}

.services-header p {
  color: #555;
  font-size: 1.1rem;
}

/* ===== Layout ===== */
.services-container {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  max-width: 1200px;
  margin: 0 auto;
  padding: 2rem;
  gap: 2rem;
}

/* ===== Service Cards ===== */
.services-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
  gap: 1.5rem;
  flex: 3;
}

.service-card {
  background: #fff;
  padding: 1.5rem;
  border-radius: 12px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.05);
  text-align: center;
  transition: all 0.3s ease;
  cursor: pointer;
}

.service-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 4px 10px rgba(0,0,0,0.08);
}

.service-card img {
  width: 60px;
  margin-bottom: 1rem;
}

.service-card h3 {
  color: #0077cc;
  font-size: 1.2rem;
}

.service-card p {
  color: #555;
  font-size: 0.95rem;
  min-height: 50px;
}

.service-card .price {
  display: block;
  font-weight: 600;
  margin: 0.5rem 0;
  color: #333;
}

.add-btn {
  background-color: #0077cc;
  color: white;
  border: none;
  padding: 0.6rem 1.5rem;
  border-radius: 6px;
  cursor: pointer;
  transition: background 0.3s;
}

.add-btn:hover {
  background-color: #005fa3;
}

.added {
  background-color: #27ae60 !important;
}

/* ===== Cart Summary ===== */
.cart-summary {
  flex: 1;
  background: #fff;
  padding: 1.8rem;
  border-radius: 12px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.05);
  position: sticky;
  top: 2rem;
  align-self: flex-start;
}

.cart-summary h2 {
  margin-bottom: 1rem;
  color: #0077cc;
  font-size: 1.5rem;
}

.cart-items {
  list-style: none;
  padding: 0;
  margin: 0 0 1rem 0;
  max-height: 200px;
  overflow-y: auto;
}

.cart-items li {
  display: flex;
  justify-content: space-between;
  margin-bottom: 0.6rem;
  font-size: 0.95rem;
}

.cart-total {
  margin: 1rem 0;
  font-size: 1.1rem;
}

.btn-primary {
  background-color: #0077cc;
  color: white;
  border: none;
  padding: 0.8rem 1.6rem;
  border-radius: 6px;
  width: 100%;
  cursor: pointer;
  transition: background 0.3s;
}

.btn-primary:hover {
  background-color: #005fa3;
}

/* ===== Responsive ===== */
@media (max-width: 900px) {
  .services-container {
    flex-direction: column;
  }

  .cart-summary {
    position: fixed;
    bottom: 0;
    left: 0;
    width: 100%;
    border-radius: 12px 12px 0 0;
    box-shadow: 0 -2px 8px rgba(0,0,0,0.15);
    padding: 1rem 1.5rem;
  }

  .cart-summary h2,
  .cart-items {
    display: none;
  }

  .cart-total {
    display: inline-block;
    margin-right: 1rem;
  }

  .btn-primary {
    width: auto;
    float: right;
  }
}
